          "notes": [
            {
              "kind": "restriction",
              "text": "弟弟在船上只指导表演；背景不得发声，不得提前宣布获救。",
              "sourceRefs": [
                {
                  "documentId": "D01",
                  "startLine": 4,
                  "endLine": 4
                }
              ]
            }
          ],
          "flow": [
            {
              "line": "封港通知：外海航道已经关闭，请所有船只等待下一次通知，不要擅自进入港口。",
              "speaker": "VO",
              "audio": {
                "mode": "voiceover",
                "subjective": false
              },
              "sourceRefs": [
                {
                  "documentId": "D01",
                  "startLine": 2,
                  "endLine": 2
                }
              ]
            },
            {
              "action": "值班员松开旋钮，指示灯仍亮。",
              "sourceRefs": [
                {
                  "documentId": "D01",
                  "startLine": 3,
                  "endLine": 3
                }
              ]
            }
          ]
        },
        {
