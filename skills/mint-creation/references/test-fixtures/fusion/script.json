          "characters": [],
          "notes": [
            {
              "kind": "continuity",
              "text": "此处听见的是播音室已经开始的同一次广播。",
              "sourceRefs": [
                {
                  "documentId": "D02",
                  "startLine": 2,
                  "endLine": 2
                }
              ]
            }
          ],
          "flow": [
            {
              "action": "走廊空无一人。",
              "sourceRefs": [
                {
                  "documentId": "D02",
                  "startLine": 2,
                  "endLine": 2
                }
              ]
            },
            {
              "sound": "蜂鸣声响起。",
