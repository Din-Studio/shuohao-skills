          ],
          "props": [
            "P01"
          ],
          "flow": [
            {
              "action": "深夜，书店门铃轻响，周亦推门进来，怀里抱着一本卷边的旧诗集，脚步在堆积如山的书架间停下。"
            },
            {
              "speaker": "C02",
              "line": "还开着吗？我想卖一本书。",
              "delivery": "声音压得很低，带着试探"
            },
            {
              "action": "陈叙从堆积如山的旧书后抬起头，放下手里的钢笔，抬手示意他把书放上柜台。"
            },
            {
              "action": "陈叙翻开诗集，目光落在扉页一行钢笔字迹上，指尖停在那里，久久没有翻页。"
            },
            {
              "speaker": "C02",
              "line": "老板？书有问题吗？"
            },
            {
              "speaker": "C01",
              "line": "没有。这本我要了，给你双倍。",
              "delivery": "声音很轻，却不容商量"
            },
            {
              "action": "周亦接过钱，转身推门离开，门铃再次轻响。"
            },
            {
              "action": "陈叙独自留在灯下，再次翻开诗集，一张折叠的字条从书页间滑落，飘在她脚边。"
            },
            {
              "action": "陈叙弯腰拾起字条，展开，纸上是三个字——「致晚晚」。"
            },
            {
              "speaker": "C01",
              "line": "晚晚，这是姐姐当年写给你的。",
              "delivery": "低声自语，带着确认后的停顿"
            }
          ]
        }
      ],
