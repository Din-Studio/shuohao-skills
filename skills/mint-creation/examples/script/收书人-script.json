{
  "source": "收书人",
  "lang": "zh",
  "episodes": [
    {
      "ep": 1,
      "targetSeconds": 30,
      "scenes": [
        {
          "sceneId": "S01",
          "lighting": "夜灯",
          "characters": [
            "C01",
