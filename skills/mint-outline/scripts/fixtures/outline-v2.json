  "story": {
    "focusCharacterIds": [
      "C01",
      "C02"
    ],
    "premise": "旧站撤并前最后一班接驳车未进入到站表，退休调度员许钟与年轻站务员林蔚需要核对它的去向。",
    "throughline": "从当前漏报追查纸质交接制度，最终决定是否同时公开许钟二十年前的错误归责。",
    "audiencePromise": "通过有出处的细节逐步理解事实，见证承认责任而非寻获替罪者。",
    "ending": "更正说明与原始交接簿一起移交；事实得到澄清，受损关系是否修复仍留给当事人。",
    "endingBeatId": "B08"
  },
  "adaptation": {
    "core": "撤站之际，一次新漏报迫使退休调度员纠正自己留下的旧记录。",
    "sourceNote": "原创，故事先见本目录故事提案.md；没有借用原作证据。",
    "keep": [
      {
        "what": "新旧交接制度的断裂",
        "why": "让当前事故与旧责任形成因果，而不是巧合破案"
      }
    ],
    "cut": [],
    "merge": [],
    "risks": [
      {
        "what": "纸面核对可能缺乏人物选择",
        "plan": "每次证据改变下一步行动；公开旧错会损害许钟的退休荣誉"
      },
      {
        "what": "容易把承认错误写成即时和解",
        "plan": "司机只确认记录更正，不替其他受影响者宣布原谅"
      }
    ],
    "cutNote": "没有改编原作，不虚构砍掉情节。",
    "mergeNote": "许钟承担记忆与责任，林蔚坚持可核对的证据；两人职能不能合并。"
  },
