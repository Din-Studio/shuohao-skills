        "endLine": 7
      }
    ]
  },
  "beats": [
    {
      "id": "B01",
      "episode": 1,
      "setup": "林蔚准备封存撤站资料",
      "outcome": "电子到站表缺少末班接驳车，封存被暂停",
      "sourceRefs": [
        {
          "documentId": "D01",
          "startLine": 2,
          "endLine": 4
        }
      ]
    },
    {
      "id": "B02",
      "episode": 1,
      "setup": "许钟认出纸簿上熟悉的补记标记",
      "outcome": "他要求先查车辆而不要追查签名，林蔚保留了原页",
      "sourceRefs": [
        {
          "documentId": "D01",
          "startLine": 5,
          "endLine": 7
        }
      ]
    },
    {
      "id": "B03",
      "episode": 2,
      "setup": "程安不愿再作无凭据的口头证明",
      "outcome": "他出示留底，车已到站，问题从失踪转为漏报",
      "resolves": [
        "Q01"
      ],
      "sourceRefs": [
        {
          "documentId": "D02",
          "startLine": 2,
          "endLine": 7
        }
      ]
    },
    {
      "id": "B04",
      "episode": 3,
      "setup": "当前到站记录空白，林蔚对照回执、电子导入记录与交接簿",
      "outcome": "林蔚查到临时接驳沿用纸簿补记，新系统没有导入该栏",
      "sourceRefs": [
        {
          "documentId": "D03",
          "startLine": 2,
          "endLine": 7
        }
      ]
    },
    {
      "id": "B05",
      "episode": 4,
      "setup": "许钟试图只更正当下漏报",
      "outcome": "他找出自己签名的旧归责页，承认曾把同类漏报归给程安",
      "sourceRefs": [
        {
          "documentId": "D04",
          "startLine": 2,
          "endLine": 7
        }
      ]
    },
    {
      "id": "B06",
      "episode": 5,
      "setup": "只有许钟自述不足以改档",
      "outcome": "程安旧回执与原始签名互证，旧归责所据的迟报时间被推翻，林蔚将核验结论写入更正说明",
      "resolves": [
        "Q02"
      ],
      "sourceRefs": [
        {
          "documentId": "D05",
          "startLine": 2,
          "endLine": 3
        }
      ]
    },
    {
      "id": "B07",
      "episode": 5,
      "setup": "新漏报可按系统故障单独结案",
      "outcome": "许钟要求把自己的旧错写入同一份更正说明，林蔚核对后共同签署",
      "sourceRefs": [
        {
          "documentId": "D05",
          "startLine": 4,
          "endLine": 7
        }
      ]
    },
    {
      "id": "B08",
      "episode": 6,
      "setup": "更正说明不能替代原始记录",
      "outcome": "两人将原簿与更正说明一并交存，程安确认收件后独自离开",
      "sourceRefs": [
        {
          "documentId": "D06",
          "startLine": 2,
          "endLine": 7
        }
      ]
    }
  ],
  "episodes": [
    {
      "ep": 1,
      "opening": "林蔚在封存前发现最后一班接驳车没有到站记录。",
      "synopsis": "撤站清点被一行空白打断。林蔚请许钟核对纸簿，他认出补记符号却避谈旧签名，建议先联系司机。林蔚保留原页，不把空白直接归为司机失联。",
      "ending": {
        "mode": "suspense",
        "event": "林蔚带着空白记录去停车场核对车辆。",
        "question": {
          "id": "Q01",
          "text": "末班车是否真的没有到站？",
          "sourceRefs": [
            {
              "documentId": "D01",
              "startLine": 4,
              "endLine": 4
            }
          ]
        }
      },
      "warnings": [],
      "sourceRefs": [
        {
          "documentId": "D01",
          "startLine": 1,
          "endLine": 7
        }
      ]
    },
    {
      "ep": 2,
      "opening": "程安拒绝只凭记忆再作一遍到站说明。",
      "synopsis": "停车场里，程安取出自己留下的回执。林蔚核对车号和时间，确认车辆已到站。许钟看到留底方式与二十年前相同，提出只修复当下系统记录。程安要求任何更正都附原始材料。",
      "ending": {
        "mode": "closure",
        "event": "林蔚将车辆去向标为已确认，转查记录为何缺失。"
      },
      "warnings": [],
      "sourceRefs": [
        {
          "documentId": "D02",
          "startLine": 1,
          "endLine": 7
        }
      ]
    },
    {
      "ep": 3,
      "opening": "林蔚将电子导入记录与纸簿补记栏逐项比较。",
      "synopsis": "临时接驳的补记栏没有进入新系统，当前漏报因此有了可复核的解释。林蔚发现旧档里也有相同空白，却被记为司机迟报。许钟认可系统断点，不愿交出旧归责页。",
      "ending": {
        "mode": "suspense",
        "event": "林蔚请求查看旧归责页原件，许钟同意次日带来。",
        "question": {
          "id": "Q02",
          "text": "旧归责是否有独立证据支持？",
          "sourceRefs": [
            {
              "documentId": "D03",
              "startLine": 4,
              "endLine": 4
            }
          ]
        }
      },
      "warnings": [],
      "sourceRefs": [
        {
          "documentId": "D03",
          "startLine": 1,
          "endLine": 7
        }
      ]
    },
    {
      "ep": 4,
      "opening": "许钟带来由自己签名的旧归责页。",
      "synopsis": "许钟解释当年为了按时结案，把未核对的漏报写成司机责任。他愿意承认，却希望不再通知程安。林蔚说明自述只能作为线索，必须让受影响的人提交留底。许钟同意联系程安。",
      "ending": {
        "mode": "open",
        "event": "许钟留下原页，不再要求林蔚只处理新系统。"
      },
      "warnings": [],
      "sourceRefs": [
        {
          "documentId": "D04",
          "startLine": 1,
          "endLine": 7
        }
      ],
      "notes": [
        {
          "kind": "performance",
          "text": "许钟担心退休荣誉受损，仅供表演，不增加内心独白；林蔚尚不知情。",
          "sourceRefs": [
            {
              "documentId": "D04",
              "startLine": 4,
              "endLine": 4
            }
          ],
          "epistemic": "fact"
        },
        {
          "kind": "continuity",
          "text": "归责页回到同一本交接簿，许钟随后将原页交给林蔚，原文没有另一本簿。",
          "sourceRefs": [
            {
              "documentId": "D04",
              "startLine": 2,
              "endLine": 2
            },
            {
              "documentId": "D04",
              "startLine": 7,
              "endLine": 7
            }
          ]
        }
      ]
    },
    {
      "ep": 5,
      "opening": "程安带来旧回执，要求与原页当面核对。",
      "synopsis": "旧回执与原始签名互证，司机归责并无事实支持。林蔚写出更正，许钟要求把自己未经核对便签字的责任一并记明。程安确认事实，不接受以道歉代替正式更正。两人将说明共同签署。",
      "ending": {
        "mode": "closure",
        "event": "更正说明签署完成，原件与说明分别编号待交。"
      },
      "warnings": [],
      "sourceRefs": [
        {
          "documentId": "D05",
          "startLine": 1,
          "endLine": 7
        }
      ]
    },
    {
      "ep": 6,
      "opening": "无台词的档案接收员指明原件编号，将原件与更正说明并排放好。",
      "synopsis": "许钟与林蔚把原簿、更正说明和核验材料同时交存。程安确认自己收到更正副本，不答应恢复旧交情。林蔚在交接清单上注明两份材料的关系，许钟接受旧错误不能从档案中抹去。",
      "ending": {
        "mode": "open",
        "event": "程安独自离开，许钟与林蔚完成撤站资料移交。",
        "question": {
          "id": "Q03",
          "text": "程安以后是否愿意恢复与许钟的来往？",
          "reason": "本故事交付事实更正，不替受影响者承诺原谅。",
          "sourceRefs": [
            {
              "documentId": "D06",
              "startLine": 7,
              "endLine": 7
            }
          ]
        }
      },
      "warnings": [],
      "sourceRefs": [
        {
          "documentId": "D06",
          "startLine": 1,
          "endLine": 7
        }
      ],
      "notes": [
        {
          "kind": "restriction",
          "text": "程安只确认更正，不承诺恢复来往；不可补成和解。",
          "sourceRefs": [
            {
              "documentId": "D06",
              "startLine": 5,
              "endLine": 7
            }
          ]
        }
      ]
    }
  ],
