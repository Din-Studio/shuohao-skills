  "episodes": [
    {
      "ep": 1,
      "opening": "林蔚在封存前发现最后一班接驳车没有到站记录。",
      "synopsis": "撤站清点被一行空白打断。林蔚请许钟核对纸簿，他认出补记符号却避谈旧签名，建议先联系司机。林蔚保留原页，不把空白直接归为司机失联。",
      "ending": {
        "mode": "suspense",
        "event": "林蔚带着空白记录去停车场核对车辆。",
        "question": {
          "id": "Q01",
          "text": "末班车是否真的没有到站？",
          "sourceRefs": [
            {
              "documentId": "D01",
              "startLine": 4,
              "endLine": 4
            }
          ]
        }
      },
      "warnings": [],
      "sourceRefs": [
        {
          "documentId": "D01",
          "startLine": 1,
          "endLine": 7
        }
      ]
    },
    {
      "ep": 2,
      "opening": "程安拒绝只凭记忆再作一遍到站说明。",
      "synopsis": "停车场里，程安取出自己留下的回执。林蔚核对车号和时间，确认车辆已到站。许钟看到留底方式与二十年前相同，提出只修复当下系统记录。程安要求任何更正都附原始材料。",
      "ending": {
        "mode": "closure",
        "event": "林蔚将车辆去向标为已确认，转查记录为何缺失。"
      },
      "warnings": [],
      "sourceRefs": [
        {
          "documentId": "D02",
          "startLine": 1,
          "endLine": 7
        }
      ]
    },
    {
      "ep": 3,
      "opening": "林蔚将电子导入记录与纸簿补记栏逐项比较。",
      "synopsis": "临时接驳的补记栏没有进入新系统，当前漏报因此有了可复核的解释。林蔚发现旧档里也有相同空白，却被记为司机迟报。许钟认可系统断点，不愿交出旧归责页。",
      "ending": {
        "mode": "suspense",
        "event": "林蔚请求查看旧归责页原件，许钟同意次日带来。",
        "question": {
          "id": "Q02",
          "text": "旧归责是否有独立证据支持？",
