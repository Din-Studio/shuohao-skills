  "episodes": [
    {
      "ep": 1,
      "opening": "林蔚在封存前发现最后一班接驳车没有到站记录。",
      "synopsis": "撤站清点被一行空白打断。林蔚请许钟核对纸簿，他认出补记符号却避谈旧签名，建议先联系司机。林蔚保留原页，不把空白直接归为司机失联。",
      "ending": {
        "mode": "suspense",
        "event": "林蔚带着空白记录去停车场核对车辆。",
        "question": {
          "id": "Q01",
          "text": "末班车是否真的没有到站？",
          "sourceRefs": [
            {
              "documentId": "D01",
