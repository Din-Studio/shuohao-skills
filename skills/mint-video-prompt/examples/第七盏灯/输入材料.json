            }
          ]
        }
      ],
      "lighting": "停电夜，煤油灯",
      "characters": [
        "C01",
        "C02"
      ],
      "props": [
        "P01"
      ],
      "beats": [
        {
          "n": 1,
          "sourceRefs": [
            {
              "documentId": "D01",
              "startLine": 3,
              "endLine": 3
            }
          ],
          "kind": "action",
          "seconds": 2.5,
          "text": "深夜停电的教室，阿禾推门进来，踮脚走到窗台前，给第七盏煤油灯添油。"
        },
        {
          "n": 2,
          "sourceRefs": [
            {
              "documentId": "D01",
              "startLine": 4,
              "endLine": 4
            }
          ],
          "audio": {
            "mode": "onscreen",
            "audibleTo": [
              "C01",
              "C02"
            ],
            "subjective": false
          },
          "kind": "line",
          "seconds": 1.1,
          "speaker": "C01",
          "delivery": "坐在后排暗处，声音很平",
          "text": "原来是你。"
        },
        {
          "n": 3,
          "sourceRefs": [
            {
              "documentId": "D01",
              "startLine": 5,
              "endLine": 5
            }
          ],
          "kind": "action",
          "seconds": 2.5,
          "text": "阿禾的手一抖，油壶磕在窗台上。他没有逃，只把灯芯拨亮。"
        },
        {
          "n": 4,
          "sourceRefs": [
            {
              "documentId": "D01",
              "startLine": 6,
              "endLine": 6
            }
          ],
          "audio": {
            "mode": "onscreen",
            "audibleTo": [
              "C01",
              "C02"
            ],
            "subjective": false
          },
          "kind": "line",
          "seconds": 2.7,
          "speaker": "C02",
          "delivery": "不回头，声音很小",
          "text": "老师，灯亮着，你就不会走。"
        },
        {
          "n": 5,
          "sourceRefs": [
            {
              "documentId": "D01",
              "startLine": 7,
              "endLine": 7
            }
          ],
          "kind": "action",
          "seconds": 2.5,
          "text": "林栀起身，拿起自己桌上那盏没点的灯，走到窗台前，放在第七盏旁边。"
        },
        {
          "n": 6,
          "sourceRefs": [
            {
              "documentId": "D01",
              "startLine": 8,
              "endLine": 8
            }
          ],
          "audio": {
            "mode": "onscreen",
            "audibleTo": [
              "C01",
              "C02"
            ],
            "subjective": false
          },
          "kind": "line",
          "seconds": 1.6,
          "speaker": "C01",
          "text": "那就再点一盏。"
        }
      ]
    }
  ],
