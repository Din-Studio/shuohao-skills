            2
          ]
        },
        {
          "beatId": "B06",
          "start": [
            2,
            3
          ],
          "end": [
            2,
            8
          ]
        }
      ],
      "scenes": [
        {
          "sceneId": "S01",
          "lighting": "下午自然光",
          "characters": [
            "C01",
            "C03"
          ],
          "props": [
            "P02",
            "P03"
          ],
          "flow": [
            {
              "action": "许秋来到工作台前，将林禾的联系纸条放在桌上。",
              "sourceRefs": [
                {
                  "documentId": "umbrella",
                  "startLine": 48,
                  "endLine": 48
                }
              ]
            },
            {
              "speaker": "C03",
              "line": "我是许秋。陈岚给了我这个，我想自己来看看。",
              "sourceRefs": [
                {
                  "documentId": "umbrella",
                  "startLine": 49,
                  "endLine": 49
                }
              ]
            },
            {
              "action": "林禾起身，把对面的椅子拉出桌沿。",
              "sourceRefs": [
                {
                  "documentId": "umbrella",
                  "startLine": 50,
                  "endLine": 50
                }
              ]
            },
            {
              "speaker": "C01",
              "line": "谢谢你来。那种蓝线反折的结，是你教的吗？",
              "sourceRefs": [
                {
                  "documentId": "umbrella",
                  "startLine": 51,
                  "endLine": 51
                }
              ]
            },
            {
              "speaker": "C03",
              "line": "教过不少人。以前东西少，一根旧线也要接着使。",
              "sourceRefs": [
                {
                  "documentId": "umbrella",
                  "startLine": 52,
                  "endLine": 52
                }
              ]
            },
            {
              "action": "林禾翻到修伞簿的线图，停在没有签名的那一页。",
              "sourceRefs": [
                {
                  "documentId": "umbrella",
                  "startLine": 53,
                  "endLine": 53
                }
              ]
            },
            {
              "speaker": "C01",
              "line": "我小时候，母亲也这样修伞。我记得手，不记得脸。",
              "sourceRefs": [
                {
                  "documentId": "umbrella",
                  "startLine": 54,
                  "endLine": 54
                }
              ]
            },
            {
              "action": "许秋把纸条折好，双手留在自己膝上。",
              "sourceRefs": [
                {
                  "documentId": "umbrella",
                  "startLine": 55,
                  "endLine": 55
                }
              ]
            },
            {
              "speaker": "C03",
              "line": "这些年有很多事。我怕一开口，就说不清楚。",
              "sourceRefs": [
                {
                  "documentId": "umbrella",
                  "startLine": 56,
                  "endLine": 56
                }
              ]
            },
            {
              "action": "林禾把修伞簿往回收了一点，留下空着的桌面。",
              "sourceRefs": [
                {
                  "documentId": "umbrella",
                  "startLine": 57,
                  "endLine": 57
                }
              ]
            }
          ]
        },
        {
          "sceneId": "S01",
          "lighting": "雨天自然光",
          "characters": [
            "C01",
            "C03"
          ],
          "props": [
            "P02",
            "P03"
          ],
          "flow": [
            {
              "action": "门外开始落雨，许秋看向门口，林禾没有关门。",
              "sourceRefs": [
                {
                  "documentId": "umbrella",
                  "startLine": 59,
                  "endLine": 59
                }
              ]
            },
            {
              "speaker": "C01",
              "line": "今天可以不说。你愿意的时候，我们再谈。",
              "sourceRefs": [
                {
                  "documentId": "umbrella",
                  "startLine": 60,
                  "endLine": 60
                }
              ]
            },
            {
              "speaker": "C03",
              "line": "你不先问我，是不是你要找的人吗？",
              "sourceRefs": [
                {
                  "documentId": "umbrella",
                  "startLine": 61,
                  "endLine": 61
                }
              ]
            },
            {
              "action": "林禾拿起笔，没有落在空着的姓名栏里。",
              "sourceRefs": [
                {
                  "documentId": "umbrella",
                  "startLine": 62,
                  "endLine": 62
                }
              ]
            },
            {
              "speaker": "C01",
              "line": "想问。但我更想听你自己说，不替你写答案。",
              "sourceRefs": [
                {
                  "documentId": "umbrella",
                  "startLine": 63,
                  "endLine": 63
                }
              ]
            },
            {
              "speaker": "C03",
              "line": "明天下午，我再来。我们从那家旧铺子说起。",
              "sourceRefs": [
                {
                  "documentId": "umbrella",
                  "startLine": 64,
                  "endLine": 64
                }
              ]
            },
            {
              "speaker": "C01",
              "line": "好，我会在这里。你想停下来的时候，我们就停。",
              "sourceRefs": [
                {
                  "documentId": "umbrella",
                  "startLine": 65,
                  "endLine": 65
                }
              ]
            },
            {
              "action": "许秋点头离开。林禾在修伞簿写下明天下午，姓名栏仍然空着。",
              "sourceRefs": [
                {
                  "documentId": "umbrella",
                  "startLine": 66,
                  "endLine": 66
                }
              ]
            }
          ]
        }
      ]
    }
  ],
