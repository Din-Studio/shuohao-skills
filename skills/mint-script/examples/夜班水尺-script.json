                  "documentId": "night",
                  "startLine": 4,
                  "endLine": 4
                }
              ]
            },
            {
              "kind": "performance",
              "text": "沈汀担心再次犯错。她的迟疑不是已经确认安全，也不是拒绝值班。心理说明不发声。",
              "sourceRefs": [
                {
                  "documentId": "night",
                  "startLine": 5,
                  "endLine": 5
                }
              ]
            }
          ],
          "flow": [
            {
              "speaker": "C02",
              "line": "等灯灭了再开门。",
