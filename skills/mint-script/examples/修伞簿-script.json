          ]
        }
      ],
      "scenes": [
        {
          "sceneId": "S01",
          "lighting": "下午自然光",
          "characters": [
            "C01",
            "C02"
          ],
          "props": [
            "P02",
            "P03"
          ],
          "flow": [
            {
              "action": "林禾翻开修伞簿，同样的绕线图出现在几个不同名字旁。"
            },
            {
              "speaker": "C01",
              "line": "我昨晚找到了旧簿，这个结不只一个人会打。"
            },
            {
              "action": "陈岚把带来的伞套放在桌角，看着那几幅线图。"
            },
            {
              "speaker": "C02",
              "line": "教大家的人叫许秋。我的伞，是她修的。"
            },
            {
              "speaker": "C01",
              "line": "你知道她住哪里吗？我可以自己去问她。"
            },
            {
              "action": "陈岚收回正要指向簿页的手，坐到林禾对面。"
            },
            {
              "speaker": "C02",
              "line": "知道，但我没问过她，不能替她把地址告诉你。"
            },
            {
              "action": "林禾看着簿页上不同的签名，把夹着的地图抽出来。"
            },
            {
              "speaker": "C01",
              "line": "你说得对。会打同一个结，也不能证明什么。"
            },
            {
              "action": "林禾把地图收进抽屉，另取一张没有写过的纸。"
            }
          ]
        },
        {
          "sceneId": "S01",
          "lighting": "傍晚自然光",
          "characters": [
            "C01",
            "C02"
          ],
          "props": [
            "P02",
            "P03"
          ],
          "flow": [
            {
              "action": "陈岚整理伞套，林禾在纸上写下自己的名字和电话。"
            },
            {
              "speaker": "C01",
              "line": "这张是我的电话。请你问问，她愿不愿意收下。"
            },
            {
              "speaker": "C02",
              "line": "如果她不想见，你能等我回来说完吗？"
            },
            {
              "action": "林禾把纸条翻过来，补上可以不回复的说明。"
            },
            {
              "speaker": "C01",
              "line": "可以。不愿意也是答复，不必替我劝她。"
            },
            {
              "speaker": "C02",
              "line": "那我只替你转交，不替你答应别的事情。"
            },
            {
              "speaker": "C01",
              "line": "谢谢你。簿子留在这里，等我有把握再翻。"
            },
            {
              "action": "陈岚收好纸条离开。林禾合上地图抽屉，没有追出去。"
            }
          ]
        }
      ]
    },
    {
      "ep": 3,
      "targetSeconds": 60,
